#!/usr/bin/env bash
# Prevent accidental publication of the private monorepo to university GitLab.
set -euo pipefail

REMOTE_NAME="${1:-}"
REMOTE_URL="${2:-}"
GITLAB_URL='git@git.cs.sun.ac.za:Computer-Science/cs345/2026/cs345/26455900-CS345.git'

# Leave all other remotes untouched. Match the URL too so a direct URL push is
# still guarded even when Git does not provide the configured remote name.
if [[ "${REMOTE_NAME}" != "gitlab" && "${REMOTE_URL}" != "${GITLAB_URL}" ]]; then
  exit 0
fi

EXPECTED_LOCAL_REF='refs/heads/gitlab-publication'
EXPECTED_REMOTE_REF='refs/heads/main'

while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "${local_ref}" != "${EXPECTED_LOCAL_REF}" || "${remote_ref}" != "${EXPECTED_REMOTE_REF}" ]]; then
    cat >&2 <<EOF
Error: blocked unsafe push to the university GitLab repository.

Only this mapping is allowed:
  gitlab-publication -> main

Attempted mapping:
  ${local_ref} -> ${remote_ref}

Build and verify the project-only export first:
  ./scripts/build_submission.sh
  ./scripts/verify_submission.sh
  git fetch gitlab main
  ./scripts/create_gitlab_publication_commit.sh submission refs/remotes/gitlab/main
  git push gitlab
EOF
    exit 1
  fi

  submission_sha="$(git rev-parse refs/heads/submission)"
  publication_sha="$(git rev-parse refs/heads/gitlab-publication)"
  if [[ "${local_sha}" != "${publication_sha}" ]]; then
    echo "Error: push SHA does not match the local gitlab-publication branch." >&2
    exit 1
  fi

  ./scripts/verify_submission.sh submission

  if [[ "$(git rev-parse "${publication_sha}^{tree}")" != "$(git rev-parse "${submission_sha}^{tree}")" ]]; then
    echo "Error: publication tree differs from the verified submission tree." >&2
    exit 1
  fi

  if ! git merge-base --is-ancestor "${submission_sha}" "${publication_sha}"; then
    echo "Error: publication history does not include the verified submission." >&2
    exit 1
  fi

  if [[ "${remote_sha}" != "0000000000000000000000000000000000000000" ]] &&
     ! git merge-base --is-ancestor "${remote_sha}" "${publication_sha}"; then
    echo "Error: publication is not a fast-forward from current GitLab main." >&2
    exit 1
  fi
done
